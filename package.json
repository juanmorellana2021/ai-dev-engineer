{
  "name": "aidevpilot",
  "displayName": "AIDevPilot",
  "description": "Full-stack validation AI - 10 specialized agents validate frontend, backend, database, security, and architecture. Catches bugs before deployment. Auto-fix included.",
  "version": "3.0.0",
  "publisher": "juanmorellana",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "copilot",
    "full-stack validation",
    "backend validator",
    "database validator",
    "code quality",
    "security",
    "auto-fix",
    "linter",
    "oop",
    "solid",
    "best practices",
    "javascript",
    "php",
    "architecture",
    "bug prevention"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:php",
    "onLanguage:typescript"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiDevEngineer.scanFile",
        "title": "AI Dev: Scan Current File"
      },
      {
        "command": "aiDevEngineer.scanWorkspace",
        "title": "AI Dev: Scan Entire Workspace"
      },
      {
        "command": "aiDevEngineer.autoFix",
        "title": "AI Dev: Auto-Fix Issues"
      },
      {
        "command": "aiDevEngineer.generateTests",
        "title": "AI Dev: Generate Tests"
      },
      {
        "command": "aiDevEngineer.showDashboard",
        "title": "AI Dev: Show Dashboard"
      },
      {
        "command": "aiDevEngineer.loadContext",
        "title": "AI Dev: Load Project Context (Copy to Clipboard)"
      },
      {
        "command": "aiDevEngineer.validateBackend",
        "title": "AI Dev: Validate Backend Handlers"
      },
      {
        "command": "aiDevEngineer.validateDatabase",
        "title": "AI Dev: Validate Database Queries"
      }
    ],
    "chatParticipants": [
      {
        "id": "aidevpilot.chat",
        "name": "aidevpilot",
        "fullName": "AIDevPilot",
        "description": "Your AI code quality co-pilot - scan, fix, and improve your code",
        "isSticky": true,
        "commands": [
          {
            "name": "scan",
            "description": "Scan current file for issues"
          },
          {
            "name": "fix",
            "description": "Auto-fix issues in current file"
          },
          {
            "name": "dashboard",
            "description": "Show code quality dashboard"
          },
          {
            "name": "test",
            "description": "Generate unit tests"
          }
        ]
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == javascript || resourceLangId == php || resourceLangId == typescript",
          "command": "aiDevEngineer.scanFile",
          "group": "aidev@1"
        },
        {
          "when": "resourceLangId == javascript || resourceLangId == php || resourceLangId == typescript",
          "command": "aiDevEngineer.autoFix",
          "group": "aidev@2"
        }
      ],
      "explorer/context": [
        {
          "command": "aiDevEngineer.scanWorkspace",
          "group": "aidev"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiDevEngineer.loadContext",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "aiDevEngineer.scanFile",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "AIDevPilot",
      "properties": {
        "aiDevEngineer.licenseKey": {
          "type": "string",
          "default": "",
          "description": "Your Pro license key"
        },
        "aiDevEngineer.autoScanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan files when saved"
        },
        "aiDevEngineer.severity": {
          "type": "string",
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Minimum severity to show warnings"
        }
      }
    }
  },
  "scripts": {
    "test": "node ./test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juanmorellana2021/ai-dev-engineer"
  },
  "license": "MIT"
}
